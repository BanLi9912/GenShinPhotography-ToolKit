{
  "name": "yuanshe-toolkit",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "license": "MIT",
  "description": "YuanShe ToolKit 原摄工具箱 · 本地优先的游戏摄影工具箱（灵感画布 / 参考图库 / 图像分析 / 图像超分）",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-superres-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-superres-assets.mjs && node scripts/build-collector.mjs",
    "build": "tsc -b && vite build",
    "build:collector": "node scripts/build-collector.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "immer": "^11.1.15",
    "konva": "^10.3.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "upscalejs": "^0.2.0",
    "vite": "^8.1.1"
  }
}
